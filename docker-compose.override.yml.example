# 本机专属挂载。compose 自动合并进 docker-compose.yml，不进版本库。
services:
  # 服务名必须与 docker-compose.yml 里的一致，否则 compose 会当成一个
  # 新服务，报 "neither an image nor a build context"，整个项目失效
  homelab-dashboard:
    volumes:
      # - /mnt/data:/mnt/data:ro
      # - /root/.ssh/id_remote:/root/.ssh/id_remote:ro
      # 1Panel OpenResty WAF 只读观察。不存在就不要启用这行，Docker 会把
      # 不存在的宿主机目录创建出来，反而让面板误以为已挂载。
      # - /opt/1panel/apps/openresty/openresty/1pwaf/data:/app/security/1panel-waf:ro
