# 复制为 watchdog.env 后填写。这个文件不要进版本库
SENDKEY=""

# 空格分隔。带 :// 走 HTTP，host:port 走 TCP。
# 建议探公网入口——它同时验证了机器活着、网络通、反代正常。
# 若这台机器和 NAS 在同一内网或同一 Tailscale 里，可再加上面板本身，如
#   TARGETS="https://nas.example.com/ 192.168.1.10:8770"
TARGETS="https://nas.example.com/"

# 连续失败几次才报。cron 每 5 分钟一次，3 次约等于 15 分钟
THRESHOLD=3
NAME="NAS"
